<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: the Tracy client opens a listening socket for the profiler, and Android refuses
     sockets to apps without INTERNET. Release builds ship without Tracy and without the permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
